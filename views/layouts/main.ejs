<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — Velox' : 'Velox' %></title>
  
  <!-- Anti-flash: set tema sebelum browser render apapun -->
  <script>
    (function() {
      const stored = localStorage.getItem('theme')
      const dark   = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
      if (dark) document.documentElement.classList.add('dark')
    })()
  </script>

  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/main.css">
    <link rel="shortcut icon" href="/icon.svg" type="image/x-icon">
</head>

<body>

  <!-- ── TOPBAR ── -->
  <header class="topbar">
    <a class="topbar-logo" href="/">
      <div class="logo-mark">
        <svg fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5">
          <path d="M5 3l14 9-14 9V3z"/>
        </svg>
      </div>
      Velox
    </a>

    <nav class="topbar-nav">
      <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'docs'      ? 'active' : '' %>" href="/docs">Docs</a>
      <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'api'       ? 'active' : '' %>" href="/api">API</a>
      <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'changelog' ? 'active' : '' %>" href="/changelog">Changelog</a>
      <a class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'examples'  ? 'active' : '' %>" href="/examples">Examples</a>
    </nav>

    <div class="topbar-right">
      <div class="search-box">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             style="width:13px;height:13px;color:var(--text-muted);flex-shrink:0">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="text" placeholder="Search docs..." />
        <span class="kbd">⌘K</span>
      </div>

      <button class="icon-btn" id="themeBtn" title="Toggle theme">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" id="themeIcon">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a class="gh-btn" href="https://github.com" target="_blank">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
        <span class="star-count">2.4k</span>
      </a>

      <button class="menu-btn" id="menuBtn" aria-label="Toggle menu">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" id="menuIcon">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- ── SIDEBAR BACKDROP (mobile) ── -->
  <div class="sidebar-backdrop" id="backdrop"></div>

  <!-- ── LAYOUT ── -->
  <div class="layout">

    <%- include('../partials/sidebar', { activePage: typeof activePage !== 'undefined' ? activePage : '' }) %>

    <!-- ── MAIN CONTENT ── -->
    <main class="main">
      <%- body %>
    </main>

  </div>

  <script>
    /* ── Theme toggle ── */
    const themeBtn  = document.getElementById('themeBtn')
    const themeIcon = document.getElementById('themeIcon')

    const ICON_DARK  = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>'
    const ICON_LIGHT = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'

    let dark = document.documentElement.classList.contains('dark')

    function updateIcon() {
      themeIcon.innerHTML = dark ? ICON_DARK : ICON_LIGHT
    }

    themeBtn.addEventListener('click', () => {
      dark = !dark
      document.documentElement.classList.toggle('dark', dark)
      localStorage.setItem('theme', dark ? 'dark' : 'light')
      updateIcon()
    })

    updateIcon()

    /* ── Mobile sidebar ── */
    const menuBtn  = document.getElementById('menuBtn')
    const menuIcon = document.getElementById('menuIcon')
    const sidebar  = document.querySelector('.sidebar')
    const backdrop = document.getElementById('backdrop')

    const ICON_OPEN  = '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>'
    const ICON_CLOSE = '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>'

    function openSidebar()  { sidebar.classList.add('open');    backdrop.classList.add('open');    menuIcon.innerHTML = ICON_CLOSE }
    function closeSidebar() { sidebar.classList.remove('open'); backdrop.classList.remove('open'); menuIcon.innerHTML = ICON_OPEN  }

    menuBtn.addEventListener('click', () => sidebar.classList.contains('open') ? closeSidebar() : openSidebar())
    backdrop.addEventListener('click', closeSidebar)

    /* ── Copy code ── */
    function copyCode(btn, text) {
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = 'copied!'
        btn.classList.add('copied')
        setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('copied') }, 2000)
      })
    }
  </script>

</body>
</html>

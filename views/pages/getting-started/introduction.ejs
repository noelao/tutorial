<%# ============================================================
    styleguide.ejs — Visual component reference
    Semua class yang tersedia ditampilkan di sini sebagai pegangan
    saat menulis halaman dokumentasi baru.
    ============================================================ %>

<!-- ── BREADCRUMB ── -->
<%# class: .breadcrumb %>
<div class="breadcrumb">
  Section Name <span>›</span> Page Name
</div>


<!-- ── PAGE HEADER ── -->
<%# class: .page-header, .tag-row, .tag, .tag-green, .tag-blue, .page-title, .page-desc %>
<div class="page-header">
  <div class="tag-row">
    <span class="tag">v2.1.0</span>
    <span class="tag tag-green">Stable</span>
    <span class="tag tag-blue">5 min read</span>
  </div>
  <h1 class="page-title">Judul Halaman</h1>
  <p class="page-desc">
    Deskripsi singkat halaman ini. Jelaskan apa yang akan dipelajari
    pembaca dalam satu atau dua kalimat.
  </p>
</div>


<div class="content">

  <!-- ── TYPOGRAPHY ── -->
  <%# class: .content h2 %>
  <h2>Heading h2 — Section Title</h2>

  <%# class: .content h3 %>
  <h3>Heading h3 — Sub Section</h3>

  <%# class: .content p %>
  <p>
    Ini adalah paragraf biasa. Gunakan untuk menjelaskan konsep, memberikan
    konteks, atau mendeskripsikan langkah-langkah. Inline <code>code</code>
    bisa disisipkan langsung di dalam paragraf menggunakan tag
    <code>&lt;code&gt;</code>.
  </p>


  <!-- ── CALLOUT — INFO ── -->
  <%# class: .callout .callout-info %>
  <div class="callout callout-info">
    <div class="callout-label">Info</div>
    Digunakan untuk informasi tambahan yang berguna tapi tidak kritis.
    Warna biru, border kiri biru.
  </div>

  <!-- ── CALLOUT — WARN ── -->
  <%# class: .callout .callout-warn %>
  <div class="callout callout-warn">
    <div class="callout-label">Perhatian</div>
    Digunakan untuk peringatan — sesuatu yang perlu diperhatikan
    sebelum melanjutkan. Warna kuning, border kiri oranye.
  </div>

  <!-- ── CALLOUT — SUCCESS ── -->
  <%# class: .callout .callout-success %>
  <div class="callout callout-success">
    <div class="callout-label">Berhasil</div>
    Digunakan untuk konfirmasi atau hasil yang diharapkan.
    Warna hijau, border kiri hijau.
  </div>


  <!-- ── CODEBLOCK — tanpa copy button ── -->
  <%# class: .codeblock, .codeblock-header, .codeblock-lang, .codeblock-body %>
  <h2>Codeblock tanpa Copy Button</h2>
  <p>Cocok untuk output, struktur folder, atau teks statis.</p>

  <div class="codeblock">
    <div class="codeblock-header">
      <span class="codeblock-lang">text</span>
    </div>
    <div class="codeblock-body">project/
├── views/
│   └── pages/
├── public/
└── index.js</div>
  </div>


  <!-- ── CODEBLOCK — dengan copy button ── -->
  <%# class: .copy-btn  |  function: copyCode(btn, text) ada di main.ejs %>
  <h2>Codeblock dengan Copy Button</h2>

  <div class="codeblock">
    <div class="codeblock-header">
      <span class="codeblock-lang">bash</span>
      <button class="copy-btn" onclick="copyCode(this, 'npm install express ejs')">copy</button>
    </div>
    <div class="codeblock-body">npm install express ejs</div>
  </div>


  <!-- ── CODEBLOCK — syntax highlight ── -->
  <%# class: .kw (keyword), .fn (function), .str (string), .cm (comment) %>
  <h2>Codeblock dengan Syntax Highlight</h2>
  <p>
    Highlight manual menggunakan <code>&lt;span&gt;</code> —
    <code>.kw</code> untuk keyword,
    <code>.fn</code> untuk function,
    <code>.str</code> untuk string,
    <code>.cm</code> untuk comment.
  </p>

  <div class="codeblock">
    <div class="codeblock-header">
      <span class="codeblock-lang">javascript</span>
      <button class="copy-btn" onclick="copyCode(this, `const express = require('express')\nconst app = express()\n\n// listen\napp.listen(3000, () => {\n  console.log('Server running')\n})`)">copy</button>
    </div>
    <div class="codeblock-body"><span class="cm">// ini adalah comment</span>
<span class="kw">const</span> express = <span class="fn">require</span>(<span class="str">'express'</span>)
<span class="kw">const</span> app     = <span class="fn">express</span>()

app.<span class="fn">listen</span>(<span class="str">3000</span>, () => {
  console.<span class="fn">log</span>(<span class="str">'Server running'</span>)
})</div>
  </div>


  <!-- ── CODEBLOCK — HTML ── -->
  <h2>Codeblock HTML</h2>

  <div class="codeblock">
    <div class="codeblock-header">
      <span class="codeblock-lang">html</span>
      <button class="copy-btn" onclick="copyCode(this, '<div class=\'container\'>\n  <h1>Hello World</h1>\n  <p>Paragraf pertama.</p>\n</div>')">copy</button>
    </div>
    <div class="codeblock-body"><span class="kw">&lt;div</span> <span class="fn">class</span>=<span class="str">"container"</span><span class="kw">&gt;</span>
  <span class="kw">&lt;h1&gt;</span>Hello World<span class="kw">&lt;/h1&gt;</span>
  <span class="kw">&lt;p&gt;</span>Paragraf pertama.<span class="kw">&lt;/p&gt;</span>
<span class="kw">&lt;/div&gt;</span></div>
  </div>


  <!-- ── CODEBLOCK — CSS ── -->
  <h2>Codeblock CSS</h2>

  <div class="codeblock">
    <div class="codeblock-header">
      <span class="codeblock-lang">css</span>
      <button class="copy-btn" onclick="copyCode(this, '.container {\n  display: flex;\n  gap: 16px;\n  background: var(--bg-surface);\n}')">copy</button>
    </div>
    <div class="codeblock-body"><span class="fn">.container</span> {
  <span class="kw">display</span>: <span class="str">flex</span>;
  <span class="kw">gap</span>: <span class="str">16px</span>;
  <span class="kw">background</span>: <span class="str">var(--bg-surface)</span>;
}</div>
  </div>


  <!-- ── PARAMS TABLE ── -->
  <%# class: .params-wrap, .params-table, .p-type, .p-req %>
  <h2>Params Table</h2>
  <p>
    Gunakan untuk mendokumentasikan parameter fungsi, opsi konfigurasi,
    atau kolom data. <code>.p-type</code> untuk tipe data (biru),
    <code>.p-req</code> untuk required (kuning).
  </p>

  <div class="params-wrap">
    <table class="params-table">
      <thead>
        <tr>
          <th>Parameter</th>
          <th>Type</th>
          <th>Keterangan</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>name</code> <span class="p-req">required</span></td>
          <td><span class="p-type">string</span></td>
          <td>Nama parameter wajib diisi.</td>
        </tr>
        <tr>
          <td><code>options</code></td>
          <td><span class="p-type">object</span></td>
          <td>Opsi tambahan. Bersifat opsional.</td>
        </tr>
        <tr>
          <td><code>callback</code></td>
          <td><span class="p-type">function</span></td>
          <td>Dipanggil setelah proses selesai dengan <code>(err, result)</code>.</td>
        </tr>
      </tbody>
    </table>
  </div>


  <!-- ── DOC NAV ── -->
  <%# class: .doc-nav, .doc-nav-item, .doc-nav-item.next, .doc-nav-dir, .doc-nav-title %>
  <%# Gunakan style="visibility:hidden" untuk sisi yang kosong (halaman pertama/terakhir) %>
  <h2>Doc Nav</h2>

  <div class="doc-nav">
    <a class="doc-nav-item" href="/docs/halaman-sebelumnya">
      <span class="doc-nav-dir">← Sebelumnya</span>
      <span class="doc-nav-title">Nama Halaman Sebelumnya</span>
    </a>
    <a class="doc-nav-item next" href="/docs/halaman-selanjutnya">
      <span class="doc-nav-dir">Selanjutnya →</span>
      <span class="doc-nav-title">Nama Halaman Selanjutnya</span>
    </a>
  </div>

  <%# Kalau halaman pertama (tidak ada prev): %>
  <h2>Doc Nav — Halaman Pertama</h2>
  <div class="doc-nav">
    <div class="doc-nav-item" style="visibility:hidden"></div>
    <a class="doc-nav-item next" href="/docs/halaman-selanjutnya">
      <span class="doc-nav-dir">Selanjutnya →</span>
      <span class="doc-nav-title">Nama Halaman Selanjutnya</span>
    </a>
  </div>

  <%# Kalau halaman terakhir (tidak ada next): %>
  <h2>Doc Nav — Halaman Terakhir</h2>
  <div class="doc-nav">
    <a class="doc-nav-item" href="/docs/halaman-sebelumnya">
      <span class="doc-nav-dir">← Sebelumnya</span>
      <span class="doc-nav-title">Nama Halaman Sebelumnya</span>
    </a>
    <div class="doc-nav-item" style="visibility:hidden"></div>
  </div>

</div>

<!-- ── Script tabs ── -->
<script>
  function switchTab(containerId, tabId, btn) {
    const container = document.getElementById(containerId)
    container.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'))
    container.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'))
    btn.classList.add('active')
    container.querySelector(`[data-tab="${tabId}"]`).classList.add('active')
  }

  function copyActiveTab(containerId) {
    const container  = document.getElementById(containerId)
    const activePanel = container.querySelector('.tab-panel.active')
    const text = activePanel ? activePanel.innerText : ''
    const btn  = container.querySelector('.tab-actions .copy-btn')
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = 'copied!'
      btn.classList.add('copied')
      setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('copied') }, 2000)
    })
  }
</script>
